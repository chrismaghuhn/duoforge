     lim.weather_max = pool ? DFI_WEATHER_SNOW : DFI_WEATHER_SUN;
     lim.vol_flags_mask = extended ? (DFI_VOL_FLAGS_MAX | DFI_VOL_FOLLOW_ME | DFI_VOL_HELPING_HAND | DFI_VOL_UNBURDEN |
                                      DFI_VOL_CHOICE_LOCK | DFI_VOL_NEWLY_SWITCHED)
