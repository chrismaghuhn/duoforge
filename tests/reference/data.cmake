# Reference payloads have one checked-in JSON file per battle. CMake alone
# builds the old flat arrays from the directory; a native build needs no
# Python/Node interpreter. Only test executables link these immutable tables.
function(_df_reference_write_if_changed _path _text)
    if(EXISTS "${_path}")
        file(READ "${_path}" _old)
        if(_old STREQUAL _text)
            return()
        endif()
    endif()
    file(WRITE "${_path}" "${_text}")
endfunction()

function(_df_reference_check_rows _file _kind _rows _count)
    string(REGEX MATCHALL "[^\n]+\n" _lines "${_rows}")
    list(LENGTH _lines _actual)
    if(NOT _actual EQUAL _count)
        message(FATAL_ERROR "${_file}: ${_kind} row count ${_actual} differs from ${_count}")
    endif()
endfunction()

function(_df_reference_check_bound _header _macro _actual)
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_header}")
    file(STRINGS "${_header}" _line REGEX "^#define ${_macro} [0-9]+u$")
    if(NOT _line)
        message(FATAL_ERROR "${_header}: missing generated bound ${_macro}")
    endif()
    string(REGEX REPLACE ".* ([0-9]+)u$" "\\1" _bound "${_line}")
    if(NOT _actual EQUAL _bound)
        message(FATAL_ERROR "${_header}: stale ${_macro}: ${_bound}, actual ${_actual}")
    endif()
endfunction()

set(_pin_file "${CMAKE_CURRENT_SOURCE_DIR}/reference/pins/reg-mc.json")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_pin_file}")
file(READ "${_pin_file}" _format_pins)
set(_pin_header "/* From the independently maintained format pins; do not edit. */\n#ifndef DF_REFERENCE_PINS_H\n#define DF_REFERENCE_PINS_H\n")
foreach(_set IN ITEMS closure team_c pool)
    string(TOUPPER "${_set}" _upper)
    foreach(_field IN ITEMS battles certified fixture_matches tiebreak_stops)
        string(JSON _value GET "${_format_pins}" sets "${_set}" "${_field}")
        string(TOUPPER "${_field}" _key)
        string(APPEND _pin_header "#define DF_REFERENCE_PIN_${_upper}_${_key} ${_value}u\n")
    endforeach()
endforeach()
string(APPEND _pin_header "#if defined(DF_CONFORMANCE_POOL_DATA)\n")
foreach(_set IN ITEMS pool team_c closure)
    if(_set STREQUAL "team_c")
        string(APPEND _pin_header "#elif defined(DF_CONFORMANCE_TEAM_C)\n")
    elseif(_set STREQUAL "closure")
        string(APPEND _pin_header "#else\n")
    endif()
    string(TOUPPER "${_set}" _upper)
    foreach(_field IN ITEMS BATTLES CERTIFIED FIXTURE_MATCHES TIEBREAK_STOPS)
        string(APPEND _pin_header "#define DF_REFERENCE_PIN_${_field} DF_REFERENCE_PIN_${_upper}_${_field}\n")
    endforeach()
endforeach()
string(APPEND _pin_header "#endif\n#endif\n")
_df_reference_write_if_changed("${CMAKE_CURRENT_BINARY_DIR}/reference_pins.h" "${_pin_header}")

set(_df_reference_sources)
set(_df_reference_tb_definitions)
set(_df_reference_tb_entries)
set(_df_reference_tb_names)
foreach(_set IN ITEMS closure team_c pool)
    file(GLOB _files CONFIGURE_DEPENDS
        "${CMAKE_CURRENT_SOURCE_DIR}/reference/battles/reg-mc/${_set}/*.json")
    list(SORT _files)
    set(_definitions)
    set(_tape)
    set(_events)
    set(_entries)
    set(_tape_base 0)
    set(_event_base 0)
    foreach(_file IN LISTS _files)
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_file}")
        file(READ "${_file}" _json)
        string(JSON _name GET "${_json}" name)
        string(JSON _format GET "${_json}" format)
        string(JSON _dataset GET "${_json}" set)
        get_filename_component(_stem "${_file}" NAME_WE)
        if(NOT _name STREQUAL _stem OR NOT _format STREQUAL "reg-mc" OR NOT _dataset STREQUAL _set)
            message(FATAL_ERROR "Reference battle identity does not match ${_file}")
        endif()
        string(JSON _body GET "${_json}" conformance definitions)
        string(JSON _entry GET "${_json}" conformance entry)
        string(JSON _tape_count GET "${_json}" conformance tape_count)
        string(JSON _event_count GET "${_json}" conformance event_count)
        string(APPEND _definitions
            "#define DF_REFERENCE_TAPE_BASE ${_tape_base}u\n#define DF_REFERENCE_EVENT_BASE ${_event_base}u\n"
            "${_body}#undef DF_REFERENCE_TAPE_BASE\n#undef DF_REFERENCE_EVENT_BASE\n")
        string(APPEND _entries "${_entry}\n")
        string(JSON _tape_rows GET "${_json}" conformance tape)
        string(JSON _event_rows GET "${_json}" conformance events)
        _df_reference_check_rows("${_file}" tape "${_tape_rows}" "${_tape_count}")
        _df_reference_check_rows("${_file}" events "${_event_rows}" "${_event_count}")
        string(APPEND _tape "${_tape_rows}")
        string(APPEND _events "${_event_rows}")
        math(EXPR _tape_base "${_tape_base} + ${_tape_count}")
        math(EXPR _event_base "${_event_base} + ${_event_count}")
        string(JSON _choices GET "${_json}" tiebreak entries)
        string(JSON _stops GET "${_json}" tiebreak stop_count)
        string(JSON _stop_rows GET "${_json}" tiebreak rows)
        _df_reference_check_rows("${_file}" tiebreak "${_stop_rows}" "${_stops}")
        if(_stops EQUAL 0)
            message(FATAL_ERROR "${_file}: empty tiebreak payload")
        endif()
        # Store by name, then globally sort, matching the original tiebreak registry.
        if(_name IN_LIST _df_reference_tb_names)
            message(FATAL_ERROR "Duplicate reference battle name: ${_name}")
        endif()
        set(_df_tb_definition_${_name} "static const df_tb_stop tb_${_name}[] = {\n${_stop_rows}};\n")
        set(_df_tb_entry_${_name} "    {\"${_name}\", ${_choices}u, tb_${_name}, sizeof tb_${_name} / sizeof tb_${_name}[0]},\n")
        list(APPEND _df_reference_tb_names "${_name}")
    endforeach()
    if(_set STREQUAL "closure")
        set(_header conformance.h)
    elseif(_set STREQUAL "team_c")
        set(_header conformance_team_c.h)
    else()
        set(_header conformance_pool.h)
    endif()
    list(LENGTH _files _actual)
    string(JSON _pinned GET "${_format_pins}" sets "${_set}" battles)
    if(NOT _actual EQUAL _pinned)
        message(FATAL_ERROR "Reference ${_set}: ${_actual} battles differ from independent pin ${_pinned}")
    endif()
    set(_declaration "${CMAKE_CURRENT_SOURCE_DIR}/reference/${_header}")
    _df_reference_check_bound("${_declaration}" DF_REFERENCE_BATTLE_COUNT "${_actual}")
    if(_tape_base EQUAL 0)
        set(_tape "    {0u, 0u, 0u, 0u},\n")
    endif()
    if(_event_base EQUAL 0)
        set(_events "    {0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u, {0u, 0u}},\n")
    endif()
    if(_tape_base EQUAL 0)
        set(_tape_base 1)
    endif()
    if(_event_base EQUAL 0)
        set(_event_base 1)
    endif()
    _df_reference_check_bound("${_declaration}" DF_REFERENCE_TAPE_COUNT "${_tape_base}")
    _df_reference_check_bound("${_declaration}" DF_REFERENCE_EVENT_COUNT "${_event_base}")
    set(_source "/* Generated by tests/reference/data.cmake from the battle directory. */\n#include \"reference/${_header}\"\n${_definitions}\nconst dfi_tape_entry conf_tape[DF_REFERENCE_TAPE_COUNT] = {\n${_tape}};\nconst duoforge_event conf_events[DF_REFERENCE_EVENT_COUNT] = {\n${_events}};\nconst df_conf_battle conf_battles[DF_REFERENCE_BATTLE_COUNT] = {\n${_entries}};\n")
    set(_output "${CMAKE_CURRENT_BINARY_DIR}/reference_${_set}.c")
    _df_reference_write_if_changed("${_output}" "${_source}")
    list(APPEND _df_reference_sources "${_output}")
endforeach()
list(SORT _df_reference_tb_names)
list(LENGTH _df_reference_tb_names _tb_actual)
_df_reference_check_bound("${CMAKE_CURRENT_SOURCE_DIR}/reference/tiebreak_ref.h" DF_REFERENCE_TIEBREAK_COUNT "${_tb_actual}")
foreach(_name IN LISTS _df_reference_tb_names)
    string(APPEND _df_reference_tb_definitions "${_df_tb_definition_${_name}}")
    string(APPEND _df_reference_tb_entries "${_df_tb_entry_${_name}}")
endforeach()
set(_source "/* Generated by tests/reference/data.cmake from the battle directory. */\n#include \"reference/tiebreak_ref.h\"\n${_df_reference_tb_definitions}\nconst df_tb_battle tb_battles[DF_REFERENCE_TIEBREAK_COUNT] = {\n${_df_reference_tb_entries}};\n")
set(_output "${CMAKE_CURRENT_BINARY_DIR}/reference_tiebreak.c")
_df_reference_write_if_changed("${_output}" "${_source}")
list(APPEND _df_reference_sources "${_output}")
add_library(duoforge_reference_data STATIC ${_df_reference_sources})
target_include_directories(duoforge_reference_data PRIVATE
    "${CMAKE_CURRENT_SOURCE_DIR}" "${PROJECT_SOURCE_DIR}/src" "${PROJECT_SOURCE_DIR}/include")
duoforge_configure_target(duoforge_reference_data)
